# Server-side only (Vercel project env vars) — never prefix these with EXPO_PUBLIC_
ANTHROPIC_API_KEY=your_api_key_here
NCBI_API_KEY=
OPENFDA_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Signs the resolve payloads that /api/report is allowed to cache
# (see SECURITY.md). Any long random string — `openssl rand -hex 32`. If unset,
# the key is derived from SUPABASE_SERVICE_ROLE_KEY instead.
REPORT_SIGNING_SECRET=

# Client-side (safe to expose in the bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Leave empty in production (web calls same-origin /api/*); set for native builds
EXPO_PUBLIC_API_BASE=
